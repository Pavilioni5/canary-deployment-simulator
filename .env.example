# ==============================================================================
# Cloud-Based Canary Deployment Simulator (Project ID: P71)
# Environment Variables Template
# Copy this file to '.env' and adjust values as needed.
# ==============================================================================

# Application Configuration
APP_NAME=CanaryDeploymentSimulator
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Security & Authentication (JWT)
# Generate a strong key in production: openssl rand -hex 32
SECRET_KEY=canary-deployment-simulator-academic-secret-key-p71-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Admin Credentials (for seed and academic viva demo)
DEFAULT_ADMIN_EMAIL=admin@canary.local
DEFAULT_ADMIN_PASSWORD=AdminSecurePassword123!
DEFAULT_ADMIN_NAME="Academic Admin"

# PostgreSQL Credentials for Docker Compose
POSTGRES_USER=canary_user
POSTGRES_PASSWORD=canary_password
POSTGRES_DB=canary_db

# Database Connection URL
# For local development against Docker Postgres:
DATABASE_URL=postgresql://canary_user:canary_password@localhost:5432/canary_db
# For container-to-container internal network:
# DATABASE_URL=postgresql://canary_user:canary_password@db:5432/canary_db
# Fallback SQLite for lightweight testing without Docker:
# DATABASE_URL=sqlite:///./canary_simulator.db

# Frontend Client Build Configuration
VITE_API_URL=http://localhost:8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost

# AWS & Cloud Mock Configuration (Optional for cloud demonstration)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_access_key_for_academic_demo
AWS_SECRET_ACCESS_KEY=mock_secret_key_for_academic_demo
CLOUDWATCH_LOG_GROUP=/academic/canary-deployment-simulator
